{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Synapse",
  "version": "0.1.1",
  "identifier": "dev.opensynapse.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Synapse",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0e0e0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Open-source Razer configurator",
    "longDescription": "Open Synapse configures Razer mice, keyboards, mousepads and accessories without accounts, telemetry or cloud."
  }
}
